# fastlane lanes for 다비드 가계부.
#
#   fastlane build   시뮬레이터용 컴파일 확인 (서명 없음)
#   fastlane beta    아카이브 후 TestFlight 업로드
#
# Homebrew로 설치한 fastlane을 그대로 쓰면 됩니다 (`brew install fastlane`). 시스템 Ruby 2.6은
# 최신 bundler를 들고 있지 않아 `bundle exec`가 먼저 죽습니다.

default_platform(:ios)

platform :ios do
  # The .xcodeproj is generated from project.yml and never committed, so every lane has to make it
  # before it can build anything. `sh` runs in the fastlane directory, hence the cd.
  before_all do
    sh("cd .. && xcodegen generate")
  end

  desc "시뮬레이터용으로 빌드만 — 서명이 없어도 컴파일 에러를 잡을 수 있습니다"
  lane :build do
    xcodebuild(
      project: "DavidLedger.xcodeproj",
      scheme: "DavidLedger",
      configuration: "Debug",
      sdk: "iphonesimulator",
      build: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  # Apple refuses a binary built against an SDK older than the one it currently requires, and says
  # so as ITMS-90111 — after the upload, after processing, after the build has been attached to a
  # version and submitted. Build 202608031815 was rejected exactly this way. Nothing in the archive
  # is wrong; the toolchain that produced it was.
  #
  # Which makes it worth thirty seconds before the archive rather than a day afterwards. The
  # selected developer directory is checked outright, because Command Line Tools carries no iOS SDK
  # and is what `xcode-select` quietly falls back to after an Xcode move or a system update.
  #
  # What it does NOT do is judge the SDK, after two attempts at a rule that was wrong both times.
  # Builds 202608031815 and 202608041848 were rejected with ITMS-90111 while the toolchain was
  # correct: Xcode 26.6 (17F113) is the shipping release, and iOS SDK 26.5 build 23F81a is what it
  # carries — deleting and reinstalling the platform does not move it, because it is not a
  # separately downloadable component here. Refusing a version behind its Xcode, or a build with a
  # seed-looking suffix, would each have blocked the only correct toolchain on the machine.
  #
  # So the SDK is printed and left alone. The remaining difference between this machine and a
  # normal one is the OS underneath — BuildMachineOSBuild recorded 26A5388g, a macOS 27 seed, with
  # an Xcode 27 beta installed alongside. That is reported too, without a verdict attached.
  #
  # The SDK floor is not hardcoded. Apple raises it about once a year, and a number written here
  # would be wrong from the day they do — set FASTLANE_MINIMUM_IOS_SDK when you want the lane to
  # enforce one. Unset, it reports what it is building with and leaves the judgement to you.
  private_lane :verify_toolchain do
    developer_dir = sh("xcode-select -p", log: false).strip
    if developer_dir.include?("CommandLineTools")
      UI.user_error!(
        "xcode-select이 #{developer_dir}를 가리킵니다. Command Line Tools에는 iOS SDK가 없어 " \
        "아카이브할 수 없습니다:\n" \
        "  sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"
      )
    end

    xcode = sh("xcodebuild -version | head -1", log: false).strip
    sdk = sh("xcrun --sdk iphoneos --show-sdk-version", log: false).strip
    sdk_build = sh("xcrun --sdk iphoneos --show-sdk-build-version", log: false).strip
    UI.important("아카이브 툴체인: #{xcode} · iOS SDK #{sdk} (#{sdk_build}) · #{developer_dir}")

    # Seeds carry a trailing lowercase letter, and the machine that produced both rejected builds
    # runs one. Said rather than enforced: Xcode 26.6's own iOS SDK reads as 23F81a, so a rule that
    # refuses the suffix refuses every correct build here.
    os_build = sh("sw_vers -buildVersion", log: false).strip
    if os_build.match?(/\d[a-z]\z/)
      UI.important(
        "빌드 머신이 시드 macOS입니다 (#{os_build}). 아카이브에 BuildMachineOSBuild로 기록되며, " \
        "ITMS-90111이 계속 나온다면 남은 변수입니다 — 정식 macOS나 Xcode Cloud에서 아카이브해 보세요."
      )
    end

    minimum = ENV["FASTLANE_MINIMUM_IOS_SDK"]
    if minimum && Gem::Version.new(sdk) < Gem::Version.new(minimum)
      UI.user_error!(
        "iOS SDK #{sdk}로는 App Store가 받지 않습니다 (ITMS-90111). #{minimum} 이상이 필요합니다.\n" \
        "Xcode를 업데이트한 뒤 `sudo xcode-select -s`로 새 버전을 가리키게 하세요.\n" \
        "현재 요구 버전: https://developer.apple.com/news/releases"
      )
    end
  end

  # altool authenticates on its own, separately from the App Store Connect session fastlane opens
  # for everything else — so the "Login successful" printed a few lines before the upload says
  # nothing about whether the upload can happen. Without credentials it archives, exports, signs,
  # and only then fails with -22938 and "Could not determine provider public id".
  #
  # Two ways to give it credentials:
  #
  #   1. An App Store Connect API key. Preferred: no 2FA prompt, no session to expire, and it is
  #      the only one that works unattended.
  #        export ASC_KEY_ID=XXXXXXXXXX
  #        export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
  #        export ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
  #      Issued in App Store Connect → 사용자 및 액세스 → 통합 → App Store Connect API.
  #
  #   2. An app-specific password for the Apple ID in Appfile.
  #        export FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
  #      Generated at account.apple.com → 로그인 및 보안 → 앱 전용 암호. The account password itself
  #      does not work here, which is what -22938 is saying.
  #
  # Returns the key for upload_to_testflight, or nil to let it fall back to the password.
  private_lane :upload_credentials do
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_path = ENV["ASC_KEY_PATH"]

    if key_id && issuer_id && key_path
      next app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: File.expand_path(key_path)
      )
    end

    if ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"].to_s.empty?
      UI.user_error!(
        "업로드 자격 증명이 없습니다. 지금 아카이브해도 업로드 직전에 실패합니다.\n" \
        "  API 키:   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH\n" \
        "  앱 암호:  FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD\n" \
        "둘 중 하나를 환경변수로 넘기세요. 자세한 설명은 Fastfile 주석에 있습니다."
      )
    end

    nil
  end

  desc "아카이브 후 TestFlight 업로드"
  lane :beta do
    # Both checks run before the archive on purpose. Each of them describes a failure that
    # otherwise surfaces only after the slow part is already done.
    verify_toolchain
    api_key = upload_credentials

    # App Store Connect rejects a build number it has seen before, and the one in project.yml is
    # a constant. A timestamp is always larger than the last one and needs nothing checked in.
    build_number = Time.now.strftime("%Y%m%d%H%M")

    build_app(
      project: "DavidLedger.xcodeproj",
      scheme: "DavidLedger",
      configuration: "Release",
      export_method: "app-store",
      # Both the app and the share extension are signed, so the profile lookup has to cover both.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
    )

    upload_to_testflight(
      # nil when the app-specific password is being used instead, which is what
      # upload_to_testflight falls back to on its own.
      api_key: api_key,
      # The upload is the slow part; waiting on Apple's processing afterwards can take half an hour
      # and tells us nothing we cannot read in App Store Connect.
      skip_waiting_for_build_processing: true
    )
  end
end
